---
import { Image } from "astro:assets";
import yo from "../assets/yo.webp";
import Download from "../icons/Download.astro";
import GithubIcon from "../icons/Github.astro";
import LinkedInIcon from "../icons/Linkedin.astro";
import MailIcon from "../icons/Mail.astro";
import Badge from "./Badge.astro";
import SocialPill from "./SocialPill.astro";
import UserIcon from "../icons/Contact.astro"; // Using Contact icon as a user icon for now, or I can check for others
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="home" class="py-6 lg:py-10 flex flex-col gap-y-12">
  <!-- Hero Section -->
  <div class="flex flex-col gap-y-4 text-pretty">
    <div class="flex items-center gap-x-4 mb-4 animate-blurred-fade-in">
      <Image
        class="rounded-full size-20 lg:size-24 object-cover border-2 border-blue-500/50"
        src={yo}
        alt="Axel photo"
      />
      <a
        href="https://www.linkedin.com/in/axel-sparta-web/"
        target="_blank"
        rel="noopener"
        class="flex justify-center items-center hover:scale-105 transition"
      >
        <Badge class="bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-300 border border-blue-400">
          {t('hero.badge')}
        </Badge>
      </a>
    </div>

    <h1
      class="text-3xl lg:text-5xl font-bold flex flex-row gap-x-4 pb-2 lg:pb-4 animate-blurred-fade-in text-slate-900 dark:text-white"
    >
      {t('hero.title')}
    </h1>
    
    <h2
      class="text-xl lg:text-2xl opacity-90 animate-blurred-fade-in font-medium text-blue-600 dark:text-blue-400"
    >
      {t('hero.subtitle')}
    </h2>

    <p class="text-lg lg:text-xl animate-blurred-fade-in max-w-[700px] text-slate-700 dark:text-slate-300">
      {t('hero.description')}
    </p>

    <nav class="animate-blurred-fade-in pt-4">
      <ul class="flex flex-wrap gap-4">
        <li>
          <SocialPill href="https://github.com/AxelSparta">
            <GithubIcon class="size-4 lg:size-6" />
            Github
          </SocialPill>
        </li>
        <li>
          <SocialPill href="https://www.linkedin.com/in/axel-sparta-web/">
            <LinkedInIcon class="size-4 lg:size-6" />
            LinkedIn
          </SocialPill>
        </li>
        <li>
          <SocialPill href="mailto:axelnicolassparta@gmail.com">
            <MailIcon class="size-4 lg:size-6" />
            {t('social.email')}
          </SocialPill>
        </li>
        <li>
          <SocialPill download="Axel-Sparta-CV.pdf" href={lang === 'es' ? '/sparta-cv-es.pdf' : '/sparta-cv-en.pdf'}>
            <Download class="size-4 lg:size-6" />
            {t('social.cv')}
          </SocialPill>
        </li>
      </ul>
    </nav>
  </div>

  <!-- Detailed About Me Section -->
  <article id="sobre-mi" class="flex flex-col gap-y-6 animate-blurred-fade-in scroll-mt-20">
    <h3 class="text-2xl lg:text-3xl font-semibold flex items-center gap-x-3 text-slate-900 dark:text-white">
      <UserIcon class="size-8" />
      {t('about.title')}
    </h3>
    
    <div class="flex flex-col gap-y-4 text-lg text-slate-700 dark:text-slate-300 text-pretty max-w-[800px]">
      <p>
        {t('about.description1')}
      </p>
      <p>
        {t('about.description2')}
      </p>
      <p class="font-medium text-blue-700 dark:text-blue-400">
        {t('about.description3')}
      </p>
    </div>
  </article>
</section>
