---
import { Image } from 'astro:assets';
import argFlag from '../assets/argentina.png';
import ukFlag from '../assets/united-kingdom.png';
import { languageList } from '../i18n/ui';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);

const flags = {
  es: argFlag,
  en: ukFlag
};
---
<ul class="flex gap-x-2">
  {Object.entries(languageList).map(([langPrefix, label]) => {
     const isCurrent = lang === langPrefix;
     const prefix = langPrefix === 'es' ? '/' : `/${langPrefix}/`;
     const flagImg = flags[langPrefix as keyof typeof flags];
     
     return (
    <li>
      <a 
        class={`flex items-center gap-x-2 text-xs lg:text-sm font-semibold hover:scale-105 transition-all px-3 py-1.5 rounded-full border ${isCurrent ? 'bg-blue-100 border-blue-300 text-blue-800 dark:bg-blue-900/40 dark:border-blue-700 dark:text-blue-300' : 'bg-white/5 border-gray-300 dark:border-white/10 opacity-70 hover:opacity-100 hover:bg-white/10'}`} 
        href={prefix}
        aria-label={label}
      >
        <Image src={flagImg} alt={`${label} flag`} class="size-4 object-cover rounded-sm" />
        <span class="uppercase">{langPrefix}</span>
      </a>
    </li>
  )})}
</ul>
