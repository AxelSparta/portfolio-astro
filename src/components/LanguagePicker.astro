---
import { languageList } from '../i18n/ui';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
---
<ul class="flex gap-x-2">
  {Object.entries(languageList).map(([langPrefix, label]) => {
     const isCurrent = lang === langPrefix;
     const prefix = langPrefix === 'es' ? '/es' : `/${langPrefix}`;
     return (
    <li>
      <a 
        class={`text-xs lg:text-base uppercase font-medium hover:opacity-100 transition-opacity px-2 py-1 rounded-md ${isCurrent ? 'opacity-100 bg-gray-200 dark:bg-gray-700' : 'opacity-60 hover:bg-gray-100 dark:hover:bg-gray-800'}`} 
        href={prefix}
        aria-label={label}
      >
        {langPrefix === 'es' ? '🇦🇷' : '🇬🇧'} {langPrefix}
      </a>
    </li>
  )})}
</ul>
