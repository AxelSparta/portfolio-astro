---
import CodeIcon from "../icons/Code.astro";
import ProjectCard from "./ProjectCard.astro";
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { PROJECTS } from '../i18n/data';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentProjects = PROJECTS[lang];
---

<section class="py-10" id="projects">
  <h2
    class="text-center text-xl lg:text-2xl font-semibold my-5 flex justify-center gap-2 items-center"
  >
    <CodeIcon class="size-5 lg:size-6" />
    <span>{t('projects.title')}</span>
  </h2>
  <div
    class="grid grid-cols-[repeat(auto-fill,minmax(300px,1fr))] justify-center gap-5"
  >
    {
      currentProjects.map(
        ({ title, description, imageSrc, tags, linkPage, linkGithub }) => (
          <ProjectCard
            title={title}
            description={description}
            imageSrc={imageSrc}
            tags={tags}
            webLink={linkPage}
            githubLink={linkGithub}
          />
        )
      )
    }
  </div>
</section>
