---
import CodeIcon from "../icons/Code.astro";
import ProjectCard from "./ProjectCard.astro";
const PROJECTS = [
  {
    title: "App de películas",
    description: "Aplicación web para buscar películas, obtener información y ver sus trailers.",
    imageSrc: "/movie-app.png",
    linkPage: "https://moviesparta.netlify.app/",
    linkGithub: "https://github.com/AxelSparta/movie-app",
    tags: ["ReactJS", "Tailwind", "React Router", "Typescript"],
  },
  {
    title: "Blog dev",
    description:
      "El proyecto consiste de un blog personal que permita a los usuarios publicar, editar y gestionar artículos.",
    imageSrc: "/blog-image.png",
    linkPage: "https://axel-blog-dev.netlify.app/",
    linkGithub: "https://github.com/AxelSparta/blog-vite",
    tags: ["ReactJS", "Tailwind", "NodeJS", "MongoDB", "Express"],
  },
  {
    title: "App de gestión de tareas",
    description:
      "Aplicación web para gestionar las tareas que se realizan en un proyecto.",
    imageSrc: "/notes-app.png",
    linkPage: "https://note-app-seven-lemon.vercel.app/",
    linkGithub:
      "https://github.com/AxelSparta/curso-nextjs-fazt/tree/main/03_notes_app",
    tags: ["Next.js", "Tailwind", "Shadcn", "Typescript", "Zod"],
  },
  {
    title: "Seguimiento de compras de USD",
    description: "Aplicación web para gestionar las compras de USD.",
    imageSrc: "/usd-tracker.png",
    linkPage: "https://usd-tracker.vercel.app/",
    linkGithub: "https://github.com/AxelSparta/usd-tracker",
    tags: ["Next.js", "Tailwind", "Typescript"],
  },
];
---

<section class="py-12" id="projects">
  <h2
    class="text-center text-xl lg:text-2xl font-semibold my-5 flex justify-center gap-2 items-center"
  >
    <CodeIcon class="size-5 lg:size-6" />
    <span>Proyectos</span>
  </h2>
  <div class="flex justify-center flex-wrap gap-5">
    {
      PROJECTS.map(
        ({ title, description, imageSrc, tags, linkPage, linkGithub }) => (
          <ProjectCard
            title={title}
            description={description}
            imageSrc={imageSrc}
            tags={tags}
            webLink={linkPage}
            githubLink={linkGithub}
          />
        ),
      )
    }
  </div>
</section>
