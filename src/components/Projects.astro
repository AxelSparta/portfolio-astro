---
import CodeIcon from "../icons/Code.astro";
import ProjectCard from "./ProjectCard.astro";
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { PROJECTS } from '../i18n/data';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentProjects = PROJECTS[lang];
---

<section class="py-12 flex flex-col gap-y-10" id="projects">
  <h2
    class="text-3xl font-semibold flex gap-x-3 items-center text-slate-900 dark:text-white"
  >
    <CodeIcon class="size-8" />
    {t('projects.title')}
  </h2>
  <div
    class="flex flex-col gap-y-16"
  >
    {
      currentProjects.map(
        ({ title, description, imageSrc, tags, linkPage, linkGithub }) => (
          <ProjectCard
            title={title}
            description={description}
            imageSrc={imageSrc}
            tags={tags}
            webLink={linkPage}
            githubLink={linkGithub}
          />
        )
      )
    }
  </div>
</section>
